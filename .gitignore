# ==============================================================================
# Fauji Niwas - Unified Monorepo .gitignore
# ==============================================================================

# Node / Web Dependencies & Builds
node_modules/
dist/
dist-ssr/
build/
.npm/
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity
*.local

# React App Specific
fauji-niwas-app/dist/
fauji-niwas-app/dist-ssr/
fauji-niwas-app/.env
fauji-niwas-app/.env.local
fauji-niwas-app/.env.*.local

# Android / Gradle
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties
android-app/.kotlin/
android-app/captures/
android-app/keystore.properties
android-app/release-key.jks

# Mobile Binaries (Never commit heavy packages or builds to git)
*.apk
*.aab
*.ap_
*.dex
*.ipa
*.app
*.dSYM/
*.ipa
*.symbols

# Firebase & Deployment Cache
.firebase/
.firebaserc.local
firebase-debug.log*
firebase-debug.*.log*
.dataconnect/

# Logs & Runtime Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
deploy_retry.log
pids
*.pid
*.seed
*.pid.lock

# Test & Code Coverage
coverage/
.nyc_output/
lib-cov/
.grunt/
bower_components/
.lock-wscript

# Temporary, Diffs & Ad-hoc Scratch Files
*.tmp
*.temp
*.diff
*.patch
temp_*
temp_extracted/
*.swp
*.swo
*~
*.bak

# Environment Variables & Secrets
.env
.env.*
!.env.example

# IDE & Editor Metadata
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.codex
.fleet/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
